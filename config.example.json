{
  "anthropic_api_key": "",

  "name": "APEX",

  "model": "claude-opus-5",
  "effort": "low",
  "max_tokens": 8000,

  "wake": {
    "words": ["apex", "ápex", "apeix", "apes", "ápice"],
    "conversation_timeout": 30,
    "require_name_every_time": false
  },

  "audio": {
    "input_device": null,
    "output_device": null,
    "sample_rate": 16000,
    "block_ms": 30,
    "silence_threshold_db": -38.0,
    "silence_duration": 0.9,
    "min_speech_duration": 0.35,
    "max_recording_duration": 25.0,
    "calibration_seconds": 2.0,
    "pre_roll_seconds": 0.4
  },

  "stt": {
    "model": "small",
    "device": "auto",
    "compute_type": "auto",
    "language": "pt",
    "wake_model": "tiny"
  },

  "tts": {
    "engine": "piper",
    "piper_voice": "pt_BR-faber-medium",
    "piper_model_dir": "~/APEX/voices",
    "edge_voice": "pt-BR-AntonioNeural",
    "rate": "+12%",
    "pitch": "-2Hz"
  },

  "clap": {
    "enabled": true,
    "count": 2,
    "min_interval": 0.12,
    "max_interval": 0.9,
    "threshold_db_above_noise": 22.0,
    "min_seconds_between_triggers": 2.0
  },

  "safety": {
    "mode": "confirm",
    "allow_shell": true,
    "confirm_timeout": 12,
    "blocked_patterns": [
      "format\\s+[a-z]:",
      "\\bdiskpart\\b",
      "\\bcipher\\s+/w",
      "\\bbcdedit\\b",
      "vssadmin[^\\n]*delete[^\\n]*shadows",
      "Remove-Item[^\\n]*['\\\"]?[Cc]:\\\\{1,2}['\\\"]?\\s*(-Recurse|$)"
    ]
  },

  "vault": {
    "path": "~/APEX/vault",
    "max_search_results": 12,
    "max_note_chars": 8000
  },

  "scheduler": {
    "enabled": true,
    "jobs": [
      {
        "name": "briefing-manha",
        "at": "08:00",
        "days": ["mon", "tue", "wed", "thu", "fri"],
        "prompt": "Rode a skill 'briefing'. Monte o briefing da manhã e salve em outputs/. Depois me diga em voz alta o resumo em no máximo 4 frases.",
        "speak": true
      },
      {
        "name": "fechamento-noite",
        "at": "21:00",
        "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"],
        "prompt": "Rode a skill 'revisao'. Feche o dia: leia o que foi capturado hoje em raw/, destile o que importa pra wiki/ e escreva o log do dia. Me diga em duas frases o que foi feito.",
        "speak": true
      }
    ]
  },

  "wol": {
    "enabled": false,
    "mac": "",
    "broadcast": "255.255.255.255",
    "port": 9
  },

  "hud": {
    "enabled": true,
    "refresh_seconds": 2,
    "accent": "red"
  },

  "workspace": "~/APEX",
  "log_conversations": true
}
